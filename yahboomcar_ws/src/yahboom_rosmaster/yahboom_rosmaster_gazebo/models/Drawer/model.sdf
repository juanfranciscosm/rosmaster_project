<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <model name="OfficeChairBlue">
   <static>true</static>
    <link name="body">
      <pose>0 0 0 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://Drawer/meshes/Drawer.obj</uri>
          </mesh>
        </geometry>
        <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
          <label>69</label>
        </plugin>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://Drawer/meshes/Drawer.obj</uri>
          </mesh>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
